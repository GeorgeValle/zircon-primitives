{
  "name": "@zircon-labs/primitives",
  "version": "0.0.0",
  "private": true,
  "description": "Public React UI primitives for Zircon projects.",
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "typecheck": "node scripts/tsc-native.mjs --noEmit",
    "build": "vite build",
    "test": "vitest run",
    "verify:package": "node scripts/verify-package.mjs",
    "check": "pnpm typecheck && pnpm build && pnpm test && pnpm verify:package"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@typescript/native": "npm:typescript@7.0.2",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "8.2.2",
    "vite-plugin-dts": "5.1.0",
    "vitest": "4.1.10"
  }
}
